# SecurityLab — WSL proxy environment helper
# Usage:  source /mnt/d/SecurityLab/configs/network/proxy.env
#
# Dynamically detects the WSL2 NAT gateway (Windows host) and a reachable
# Clash/V2Ray HTTP proxy port, then exports proxy variables ONLY when the
# proxy is actually reachable. Nothing here is hard-coded to a fixed IP.
#
# Why: direct GitHub git smart-HTTP (info/refs) is interfered with on this
# network while the proxy path works (verified 2026-09-20).
# To undo in a shell:  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY

_sl_detect_proxy() {
    local gw port code
    gw=$(ip route show default 2>/dev/null | awk '/default/ {print $3; exit}')
    if [ -z "$gw" ]; then
        return 1
    fi
    # Clash Verge mixed port 7890, Clash backup 7897, common V2Ray 10809/10808
    for port in 7890 7897 10809 10808; do
        code=$(curl -sS --max-time 3 -x "http://${gw}:${port}" -o /dev/null \
            -w '%{http_code}' https://github.com 2>/dev/null)
        if [ "$code" = "200" ] || [ "$code" = "301" ] || [ "$code" = "302" ]; then
            echo "http://${gw}:${port}"
            return 0
        fi
    done
    return 1
}

if _sl_proxy_url=$(_sl_detect_proxy); then
    export http_proxy="$_sl_proxy_url"  https_proxy="$_sl_proxy_url"  all_proxy="$_sl_proxy_url"
    export HTTP_PROXY="$_sl_proxy_url" HTTPS_PROXY="$_sl_proxy_url" ALL_PROXY="$_sl_proxy_url"
    export no_proxy="localhost,127.0.0.1,::1,172.0.0.0/8"
    export NO_PROXY="localhost,127.0.0.1,::1,172.0.0.0/8"
    echo "[proxy.env] active: $_sl_proxy_url"
else
    echo "[proxy.env] no reachable proxy on WSL gateway; leaving direct connection"
fi
unset -f _sl_detect_proxy
